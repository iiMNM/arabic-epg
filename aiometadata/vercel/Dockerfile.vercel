# AIOMetadata على Vercel (Container) — يبني من الصورة الرسمية (الإصدار يحدّثه workflow update-addons تلقائياً)
FROM ghcr.io/cedya77/aiometadata:4.1.0
ENV NODE_ENV=production \
    TZ=Asia/Riyadh \
    PORT=80
EXPOSE 80
# Neon يعطي DATABASE_URL، والإضافة تقرأ DATABASE_URI
ENTRYPOINT ["/bin/sh", "-c", "export DATABASE_URI=\"${DATABASE_URI:-$DATABASE_URL}\"; exec node dist/server/server.js"]
