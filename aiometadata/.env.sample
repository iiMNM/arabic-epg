# ===== AIOMetadata — الإعدادات =====
# الدومين اللي يأشّر على السيرفر (أو 1-2-3-4.sslip.io المجاني)
DOMAIN=1-2-3-4.sslip.io
# نفس الدومين مع https:// — ضروري عشان Stremio يلقى الـ manifest
HOST_NAME=https://1-2-3-4.sslip.io

PORT=3232
NODE_ENV=production
LOG_LEVEL=info
TZ=Asia/Riyadh

# قاعدة البيانات (SQLite داخل مجلد data/) والكاش (Redis)
DATABASE_URI=sqlite://addon/data/db.sqlite
REDIS_URL=redis://aiometadata_redis:6379

# ===== الحماية =====
# يحمي لوحة التحكم:  openssl rand -hex 32
ADMIN_KEY=
# باسورد لصفحة الإعدادات عشان محد غيرك يستخدم نسختك (اختياري بس ننصح فيه)
ADDON_PASSWORD=

# ===== مفاتيح المصادر =====
# TMDB أساسي — مجاني من https://www.themoviedb.org/settings/api  (API Key v3)
# نحطه كمفتاح "مدمج" عشان ما ينكشف للزوار (BUILT_IN_* ما ينرسل للمتصفح)
BUILT_IN_TMDB_API_KEY=
# TVDB اختياري بس ينصح فيه للمسلسلات — https://thetvdb.com/api-information
BUILT_IN_TVDB_API_KEY=
# صور أحلى (اختياري) — https://fanart.tv/get-an-api-key/
BUILT_IN_FANART_API_KEY=
# بوسترات بالتقييم (اختياري، مدفوع) — https://ratingposterdb.com
BUILT_IN_RPDB_API_KEY=
# قوائم MDBList (اختياري)
BUILT_IN_MDBLIST_API_KEY=

# MAL / الأنمي (الـ Jikan العام انقفل، هذا البديل الافتراضي)
JIKAN_API_BASE=https://api.tenrai.org/v1
