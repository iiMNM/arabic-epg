# الدومين اللي بيفتح عليه السيرفر (لازم يأشّر على IP السيرفر).
# ما عندك دومين؟ استخدم sslip.io: لو IP السيرفر 1.2.3.4 حط 1-2-3-4.sslip.io
DOMAIN=1-2-3-4.sslip.io

# نفس الدومين مع https:// (يدخل في رابط الإضافة وروابط البث)
BASE_URL=https://1-2-3-4.sslip.io

# مفتاح تشفير الإعدادات — 64 حرف hex. ولّده بـ:  openssl rand -hex 32
# لا تغيّره أبداً بعد أول تشغيل وإلا تضيع كل الإعدادات المحفوظة.
SECRET_KEY=

# يوزر:باسورد لصفحة الإعدادات (/stremio/configure) والبروكسي — عشان ما يستخدم سيرفرك أحد غيرك.
AIOLIVETV_AUTH=admin:غيّر-هذا-الباسورد
